# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=healthcare_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# RABBITMQ CONFIGURATION
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBIT_USERNAME=hoanglong
RABBIT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# MINIO CONFIGURATION
# ============================================
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=doctor-cvs

# ============================================
# JWT CONFIGURATION (at least 32 characters)
# ============================================
JWT_SIGNER_KEY=CHANGE_ME_JWT_SECRET_KEY_32_CHARS_PLUS

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# ============================================
# MOMO PAYMENT CONFIGURATION
# ============================================
PARTNER_CODE=MOMO
ACCESS_KEY=your_momo_access_key
SECRET_KEY=your_momo_secret_key
ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
RETURN_URL=https://your-domain.com/payment-return
NOTIFY_URL=https://your-domain.com/api/payments/momo/ipn

# ============================================
# CORS & FRONTEND
# ============================================
FRONTEND_PORT=80
FRONTEND_URL=http://localhost
PUBLIC_FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
VITE_API_URL=http://localhost:8080

# ============================================
# EMAIL CONFIGURATION (optional)
# ============================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ============================================
# POSTGRES PORT (if you want to expose)
# ============================================
POSTGRES_PORT=5432